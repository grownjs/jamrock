#!/usr/bin/env -S deno run --env-file --allow-all --unstable-node-globals --unstable-net
// @ts-nocheck
/* global Deno */
import('../lib/deno/runtime.js').then(() => Promise.all([
  import('../lib/deno/main.mjs'),
  import('./cli.mjs'),
]).then(([env, cli]) => cli.default(env.default, Deno.args, env.capabilities))).catch(console.error);
