#!/usr/bin/env gjs -m
import GLib from 'gi://GLib';
const HOME = GLib.get_home_dir();
import(HOME + '/.jamrock/package/lib/gtk4/runtime.js').then(() => Promise.all([
  import(HOME + '/.jamrock/package/lib/gtk4/main.mjs'),
  import(HOME + '/.jamrock/package/bin/cli.mjs'),
]).then(([env, cli]) => cli.default(env.default, process.argv.slice(2)))).catch(logError);
