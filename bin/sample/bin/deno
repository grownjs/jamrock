#!/usr/bin/env -S deno run --env-file --allow-all --unstable-node-globals --unstable-net
// @ts-nocheck
import(Deno.env.get('HOME') + '/.jamrock/package/lib/deno/runtime.js').then(() => Promise.all([
  import(Deno.env.get('HOME') + '/.jamrock/package/lib/deno/main.mjs'),
  import(Deno.env.get('HOME') + '/.jamrock/package/bin/cli.mjs'),
]).then(([env, cli]) => cli.default(env.default, Deno.args))).catch(console.error);;
