#!/bin/bash
# @ts-nocheck
set -e

if [[ "$(uname -s)" == "Darwin" ]]; then
  if [[ -z "$DYLD_LIBRARY_PATH" ]]; then
    export DYLD_LIBRARY_PATH="$LIB_PATH"
  else
    export DYLD_LIBRARY_PATH="$LIB_PATH:$DYLD_LIBRARY_PATH"
  fi
fi

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

gjs -m "$SCRIPT_DIR/bin/gjs.mjs" "$@"
